			<Property name="Korean" value="" />
			<Property name="Japanese" value="" />
			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="TRA_NPC_ANOMALY_DESC_2">
			<Property name="Id" value="TRA_NPC_ANOMALY_DESC_2" />
			<Property name="English" value="Polo bobs up and down happily as I approach, apparently convinced that I am some kindred spirit in an odyssey of exploration and invention. I am undecided as to whether I share this ethos.&#xA;&#xA;Polo is particularly fascinated by how my brain is affected by interaction with alien language and culture. Can I truly understand such profoundly unfamiliar concepts? Is there a limit to how much I can learn? I have wondered this too." />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
