			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="TRA_NPC_ANOMALY_DESC_3">
			<Property name="Id" value="TRA_NPC_ANOMALY_DESC_3" />
			<Property name="English" value="Polo's muzzle breaks into a wide, warm smile at the sight of me. Maybe too wide, given we have only met twice before. Perhaps the jovial Gek feels lonely out here, with only the jittery Korvax Priest for company.&#xA;&#xA;This time, they engage me in talk of wealth. How does an economy function when somehow stretched across an entire galaxy? Just how much can those trade terminals pay out? Polo would welcome any insights." />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
