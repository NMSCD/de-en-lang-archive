		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_PURPM_03">
			<Property name="Id" value="UI_PORTAL_PURPM_03" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="&lt;STORY_HIGH&gt;–{{ Ich habe es gespürt, Disruptor. Ich habe es gespürt! Ein Schmerz in meinen eigenen Kristallen. Ein Lebensimpuls. Sie hat einen Stern manifestiert! }}–&lt;&gt;&#xA;&#xA;&lt;SPECIAL&gt;Stellare Manifestation &lt;IMG&gt;SLASH&lt;&gt; Gelöschter Sektor wiederhergestellt&lt;&gt;&#xA;&#xA;Ich habe Yabli-α gefragt, wie man ihn erreichen konnte.&#xA;&#xA;&lt;STORY_HIGH&gt;–{{ Ich habe meinen Körper in Eile gebaut. Meine Sicht ist begrenzt. Aber deine – }}–&#xA;–{{ Natürlich. Dein Schiff ist nicht kompatibel. Ihr Raum wird immer im Widerspruch zu dieser Realität stehen.&lt;&gt;&#xA;&#xA;Aber er hatte eine Idee.&#xA;&#xA;&lt;STORY_HIGH&gt;–{{ Im Laufe der Jahre habe ich eine anomale Raumstation entdeckt. An Bord befindet sich ein Konstrukt. Eine komplexe Entität. Es weiß vieles. Es wird wissen, wie man deinen Hyperantrieb konfiguriert. }}–&lt;&gt;" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
