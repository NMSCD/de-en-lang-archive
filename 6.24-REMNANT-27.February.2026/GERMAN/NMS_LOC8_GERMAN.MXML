		<Property name="Table" value="TkLocalisationEntry" _id="UI_S12_POI_1_RES">
			<Property name="Id" value="UI_S12_POI_1_RES" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Eine Welle der Ruhe überflutet mich, als die Erinnerung mich ergreift. Dieser heitere Riese sendet sein Lied, eine analoge Übertragung reiner Emotionen.&#xA;Während die Musik mein Schiff verschlingt, fühle ich mich frei, befreit von allen Zwängen, allen Beschränkungen. Eine grenzenlose Unendlichkeit von Möglichkeiten breitet sich vor mir aus. Es ist wunderschön, überwältigend. Es ist &lt;DELAY&gt;1.0&lt;&gt;furchterregend.&#xA;. Das Lied verklingt, und ich kehre zurück in die Behaglichkeit von Metall und Licht, in die Realität meines Raumschiffs und meines Exo-Anzugs." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
			<Property name="TencentChinese" value="" />
			<Property name="Korean" value="" />
			<Property name="Japanese" value="" />
			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="UI_S12_POI_2_RES">
			<Property name="Id" value="UI_S12_POI_2_RES" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Der kolossale Megalith schwebt vor mir, noch surrealer, weil er aus dem planetarischen Kontext gerissen wurde, in dem er einst stand.&#xA;Ich fühle mich mit all den Händen konfrontiert, die seinen Stein berührt haben, mit all den Wesen, die ihn geformt haben, die vor ihm gestanden haben. All die Schicksale, die dieser Stein aufsteigen und wieder fallen sah, während er allein weiterlebte.&#xA;Und nun steht er da – selbst nur noch eine Erinnerung, seiner Realität entrissen, im Raum schwebend ..." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
			<Property name="TencentChinese" value="" />
			<Property name="Korean" value="" />
			<Property name="Japanese" value="" />
			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="UI_S12_POI_3_RES">
			<Property name="Id" value="UI_S12_POI_3_RES" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Ich kann nicht anders, als zu staunen über die schiere Größe des Titanen, der in dieser Erinnerung lebt. Illusion oder nicht, ich bin froh, dass es nur Knochen sind ...&#xA;Als meine anfängliche Überraschung verblasst, frage ich mich – warum ist diese Kreatur tot? Warum hat sie sich nicht entschieden, sich in der Herrlichkeit des Lebens an sich zu erinnern? Und was könnte ein solches Wesen töten ...&#xA;Doch die Knochen geben keine Antwort auf meine Fragen. Sie sind einfach da." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
