			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Er ist eine Gestalt in der Dunkelheit mit abgewandtem Kopf, buckeligem Rücken und hochgezogenen Schultern. Er hält eine Waffe in den Händen.&#xA;&#xA;Eine Stimme in ihm schreit wegen einer Grenzüberschreitung, wegen einer Verderbnis, aber es ist nicht meine Stimme.&#xA;&#xA;Er lächelt zum letzten Mal." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
