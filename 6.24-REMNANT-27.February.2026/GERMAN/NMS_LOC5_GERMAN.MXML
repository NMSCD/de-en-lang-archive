			<Property name="Id" value="UI_U4_TRAVELLER_LOG_EXTRA_7" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="In dieser Nacht zeigte der ATLAS ihm das Multiversum.&#xA;&#xA;Er sah eine Welt, in der Milliarden von Zweibeinern ihre Leben verschliefen und dabei glücklich, traurig, wütend und allein waren. Zwischen den Sternen war nichts – nichts, wonach man sich sehnen könnte, nichts zu entdecken. Und als würde er aus einem Traum erwachen, veränderte der Reisende alles. 16, sang er. 16 ...&#xA;&#xA;Er sah andere. Einen Ort des Friedens, an dem sich der Reisende voller Glückseligkeit von Welt zu Welt bewegte und so etwas über das Leben lernte.&#xA;&#xA;Er sah eine Welt voller Wunder, ein gefallenes Imperium. Er sah Balaron, den Korvax-Primus. Er sah Hunderte Welten, die waren und hätten sein können, und die vielen Reisenden, die sie erkundeten. Er sah Zufriedenheit." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
