			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="UI_U4_TRAVELLER_LOG_EXTRA_8">
			<Property name="Id" value="UI_U4_TRAVELLER_LOG_EXTRA_8" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Er verstand nicht, warum er nicht das fühlen konnte, was sie fühlten. Er wusste nicht, was das Problem war.&#xA;&#xA;„Ich bin froh, dass ich dich verlassen habe“, sagte er. „Du verdienst es, allein zu sein.“&#xA;&#xA;Der ATLAS sagte nichts.&#xA;&#xA;„Alles, was ich für dich getan habe ... alles, was du siehst, siehst du durch meine Augen! Es gehört mir, es ist mein Geburtsrecht!“&#xA;&#xA;Der ATLAS sagte wieder nichts. Er drehte sich um und wartete auf das Unausweichliche." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
