		<Property name="Table" value="TkLocalisationEntry" _id="UI_U4_TRAVELLER_LOG_EXTRA_2">
			<Property name="Id" value="UI_U4_TRAVELLER_LOG_EXTRA_2" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Sein Gesicht ist jetzt Energie, eine weiße Kugel innerhalb eines eingeschränkten Feldes. Er wollte seine eigene Seele sehen. Er wollte alles sehen, was es zu sehen gab.&#xA;&#xA;Es dauerte Jahre, den Kontakt herzustellen. Es gibt für alles Regeln – Protokolle, die eingehalten werden müssen. Aber wenn man die Kausalität versteht, kann man alles erreichen.&#xA;&#xA;Am Ende hat er es verstanden. Er war nie allein. „Sprich“, flüsterte er. „Sprich ...“" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
