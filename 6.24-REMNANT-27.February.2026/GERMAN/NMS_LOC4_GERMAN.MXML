			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="NPC_COMM_WEEK_06_STORY_END_9">
			<Property name="Id" value="NPC_COMM_WEEK_06_STORY_END_9" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Ich sehe, wie der Fremde auf das Bedienfeld des Portals tippt, als würden seine Hände von einer unsichtbaren Macht geführt werden. Der Durchgang öffnet sich und sein blaues Licht erhellt die Umgebung.&#xA;In diesem Licht wendet sich der Fremde an seine verbleibende Crew. Er versucht sie davon zu überzeugen, ihm durch das Portal zu folgen, hat aber keinen Erfolg. Seine Crewmitglieder gehen, einer nach dem anderen. Nur noch der Fremde bleibt zurück.&#xA;Schließlich nähert er sich dem Portal. Der Schaum verschlingt ihn und verschwindet dann. Das Portal schließt sich leise. Das ist das Ende der Aufzeichnung." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
