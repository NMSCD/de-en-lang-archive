		<Property name="Table" value="TkLocalisationEntry" _id="NPC_COMM_WEEK_06_STORY_END_10">
			<Property name="Id" value="NPC_COMM_WEEK_06_STORY_END_10" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Ich sehe, wie der Fremde das offene Portal untersucht und dann weggeht. Die Aufzeichnung zeigt den Rest seiner Reise. Er geht weiter, Kilometer um Kilometer, immer nur nachts. Er findet jede Lichtquelle, untersucht sie und lässt sie dann zurück.&#xA;Er durchsucht jedes verlassene Gebäude, das er findet, und sucht nach dem Reisenden, der ihm die Erlösung versprochen hat. Die Aufzeichnungen scheinen endlos weiterzugehen. Ich spule vor, doch das Muster ändert sich nie und der Fremde scheint nicht zu altern.&#xA;Ich suche immer weiter, finde aber das Ende seiner Geschichte nicht." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
