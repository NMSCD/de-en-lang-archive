		<Property name="Table" value="TkLocalisationEntry" _id="UI_U4_TRAVELLER_LOG_7">
			<Property name="Id" value="UI_U4_TRAVELLER_LOG_7" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Irgendetwas stimmte überhaupt nicht. Die Atlas-Schnittstelle war still geworden, seine Kugel abgekühlt und nahezu ergraut. Die Computer reagierten nicht. Nichts reagierte.&#xA;&#xA;Es dauerte ein paar Augenblicke, bis ich merkte, dass Laylaps verschwunden war.&#xA;&#xA;Ich war allein." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
