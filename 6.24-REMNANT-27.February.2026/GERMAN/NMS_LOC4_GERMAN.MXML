		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="NPC_WATERPLAQUE_7">
			<Property name="Id" value="NPC_WATERPLAQUE_7" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Ich habe ihn gefunden. Es hat Tage gedauert, aber ich hab ihn gefunden. Die schlimmsten Tage, seit ich die Oberfläche verlassen hatte. Ich hatte ihn so sehr vermisst.&#xA;&#xA;Es war alles nur meine Schuld. Als ich ihn fand, war er immer noch so perfekt wie am ersten Tag. Doch meine Augen ... irgendetwas verändert sich.&#xA;&#xA;Ich bin so froh, dass ich ihn wiederhabe." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
