		<Property name="Table" value="TkLocalisationEntry" _id="UI_U4_TRAVELLER_LOG_9">
			<Property name="Id" value="UI_U4_TRAVELLER_LOG_9" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Sie hatten meinen Freund gefangen genommen. Ich sah sie aus der Ferne, die Familie aus Glas in all ihrer Pracht, wie sie den gefallenen Wächter wog, dessen Licht in ihrer entsetzlichen Umarmung flackerte.&#xA; &#xA;Ich gab einen ungewollten Schrei von mir, als sie in seine Hautpanzerung schnitten, und jeder Blick, jedes boshafte Grinsen drehte sich zu mir.&#xA; &#xA;Ich floh, aber es hatte keinen Sinn. Es waren Hunderte. Sie fanden mich." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
