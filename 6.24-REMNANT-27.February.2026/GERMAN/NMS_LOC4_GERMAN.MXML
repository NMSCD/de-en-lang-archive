		<Property name="Table" value="TkLocalisationEntry" _id="NPC_COMM_WEEK_06_STORY_END_8">
			<Property name="Id" value="NPC_COMM_WEEK_06_STORY_END_8" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Der Fremde ritzt seine Glyphen in den Stein des Portals. Zuversichtlich nähert er sich der Schwelle, als würde er von einer vertrauten Stimme gerufen werden. Er betritt das Portal und ein gleißender Blitz weißen Lichts stört die Aufzeichnung.&#xA;Als das Bild wieder klar wird, ist das Portal verschwunden. Ich sehe nur noch Sterne und unendlich viele Systeme. Die Aufzeichnung fokussiert einen Stern und nähert sich ihm schnell. Plötzlich erscheint der gleiche Lichtblitz und eine neue Welt wird geboren.&#xA;Die Aufzeichnung endet. Was habe ich gerade gesehen?" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
