			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Er stand über mir, als ich aufwachte, plapperte vor sich hin und seine Augen waren irgendwo zwischen Schrecken und Freude gefangen.&#xA; &#xA;Er war der größte Gek, den ich jemals gesehen hatte, aber das Geheimnis war schnell gelöst. Er fragte mich nach dem Imperium – er wollte wissen, ob die Erstgebrüteten noch immer von ihm sprachen. In seinem früheren Leben besaß er nämlich Hunderte Korvax-Sklaven.&#xA;Er erinnert sich nicht, wie er an diesen Ort gekommen ist. In seinem Gesicht wimmelte es vor Nanit. Er ist allein." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
