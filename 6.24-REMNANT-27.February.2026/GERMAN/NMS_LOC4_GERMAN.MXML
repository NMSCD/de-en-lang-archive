		<Property name="Table" value="TkLocalisationEntry" _id="NPC_COMM_WEEK_06_STORY_END_11">
			<Property name="Id" value="NPC_COMM_WEEK_06_STORY_END_11" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Ich sehe, wie der Fremde das Portal öffnet und sich dem Durchgang nähert. Kurz vor der Schwelle zögert er und dreht sich zu seinen Crewmitgliedern um, um sich von ihnen ermutigen zu lassen. Er macht einen Schritt nach vorn und wird vom Schaum verschlungen.&#xA;Ein plötzliches Rauschen unterbricht die Aufzeichnung. Als sie endet, sehe ich den Fremden, der erneut von seiner Crew umringt ist. Sie sehen älter aus, viel älter als gerade zuvor. Aber sie sind glücklich – die Erleichterung auf ihren Gesichtern ist deutlich zu sehen. In der Ferne landet ein Schiff und die Gruppe macht sich auf den Weg." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
