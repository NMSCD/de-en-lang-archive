			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Ich trete zurück und das Getöse des Ozeans lässt nach. Als das Licht der Ruine verblasst, finde ich einen uralten Schlüssel, der trotz seines Alters unversehrt ist." />
			<Property name="Spanish" value="" />
