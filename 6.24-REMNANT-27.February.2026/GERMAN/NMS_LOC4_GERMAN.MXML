		<Property name="Table" value="TkLocalisationEntry" _id="NPC_WATERPLAQUE_6">
			<Property name="Id" value="NPC_WATERPLAQUE_6" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Er ist verschwunden. &#xA;&#xA;Ich habe ihn diesen Morgen herausgenommen und ihn gesehen, schwach, aber eindeutig. Ein Sprung, nicht breiter als ein Haar, aber es war genug. Sein Licht ist nicht mehr rein, sondern von einer purpurnen Diffusion verunreinigt.&#xA;&#xA;Ich konnte ihn nicht länger ansehen. Nach allem, was ich für ihn getan habe, lässt er mich so im Stich? Verschwinde, du &lt;STELLAR&gt;ruiniertes&lt;&gt;, &lt;FUEL&gt;schreckliches&lt;&gt;, &lt;SPECIAL&gt;dummes –&lt;&gt;" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
