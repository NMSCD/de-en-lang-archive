		<Property name="Table" value="TkLocalisationEntry" _id="UI_U4_TRAVELLER_LOG_8">
			<Property name="Id" value="UI_U4_TRAVELLER_LOG_8" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Ich hörte die Musik heute Morgen wieder – dasselbe Signal, das mich zu dieser Welt geführt hatte. Ich blieb stehen und hörte zu, stellte meine Instrumente ein, um die Quelle zu finden, und erwartete ein anderes Ergebnis ... Aber welchen Nutzen hatte die Wissenschaft hier?&#xA;&#xA;Was nützen die Gebete von Daten, wenn ein Computer brennt?" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
