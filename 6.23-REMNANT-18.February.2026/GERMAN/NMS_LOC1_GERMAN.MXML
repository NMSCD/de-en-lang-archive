			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="The ending becomes visible. Drawing toward our locus, we sense you. What has been witnessed cannot be unseen. &#xA;There is no sanctuary, only the end-point and communion. Close now." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
