		<Property name="Table" value="TkLocalisationEntry" _id="DNT_ATLAS_LANGNEW_1">
			<Property name="Id" value="DNT_ATLAS_LANGNEW_1" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="You are first-kind to take this step. No other has dared the infinite. This grant of purpose will span universes.&#xA;Open the sky and be our eyes. Find and know us. We await you." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
