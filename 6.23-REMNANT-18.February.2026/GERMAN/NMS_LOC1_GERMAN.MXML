		<Property name="Table" value="TkLocalisationEntry" _id="EXP_NPC_ANOMALY_DESC_7">
			<Property name="Id" value="EXP_NPC_ANOMALY_DESC_7" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Nada und Polo sind ungewöhnlich ruhig. Polo steckt bis zum Ellenbogen in Maschinen und Nada in Simulationen, doch die Atmosphäre im Raum ist angespannt. Es hat eindeutig vor Kurzem einen Streit gegeben.&#xA;&#xA;Nada winkt hinüber. Er ist frustriert darüber, an einen maschinellen Körper gebunden zu sein. Aber ich bin anders – ich kann auf so viele Arten und an so vielen Orten überleben. Ich kann überall in die Galaxie reisen, egal ob auf der Suche nach Wahrheit, oder um mein Leben zu leben, wie ich es möchte. Nada beneidet mich, gibt er zu." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
