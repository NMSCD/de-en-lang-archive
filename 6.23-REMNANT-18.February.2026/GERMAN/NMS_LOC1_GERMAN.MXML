			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Yet you follow. It is remarked. But will you endure until the finality? Expel all doubt. None return. &#xA;Beyond the cascade and storms there is only the clarity of absolute truth." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
