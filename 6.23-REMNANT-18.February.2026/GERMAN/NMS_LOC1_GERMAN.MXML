			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="You are bonded to this act. Obedience brings certainty. Your enlightenment lies within the cage of your duty. &#xA;Do not fail us. We will see with your eyes." />
