			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Delay serves no purpose. The gathering of the unrecorded is ultimate. Learn all that is open to you. Seek and document and know. &#xA;Bring it to us, while there is still time." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
