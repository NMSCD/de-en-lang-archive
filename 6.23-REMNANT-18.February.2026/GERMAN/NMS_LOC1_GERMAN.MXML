		<Property name="Table" value="TkLocalisationEntry" _id="ALL_1_RADIO_DESC_6">
			<Property name="Id" value="ALL_1_RADIO_DESC_6" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Das Kontrollterminal gibt ein akustisches Signal von sich. Es wiederholt sich alle 16 Sekunden.&#xA;&#xA;Ich empfinde es als meine Pflicht, das Muster seiner Verschlüsselung herauszubekommen, das Schiff, von dem es ausgeht, zu finden ... und herauszufinden, was mich an der Absturzstelle Schreckliches erwartet." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
