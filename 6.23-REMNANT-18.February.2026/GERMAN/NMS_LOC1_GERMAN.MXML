		<Property name="Table" value="TkLocalisationEntry" _id="EXP_1_PLAQUE_LORE_24">
			<Property name="Id" value="EXP_1_PLAQUE_LORE_24" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Die Erstgebrüteten konnten den äußeren Rand ihres riesigen Imperiums nicht kontrollieren. Der Kult des Atlas wuchs heran. Er lehrte Harmonie durch Bedeutungslosigkeit.&#xA;&#xA;Geister, die nur Krieg kannten, begannen, Fragen zu stellen. Gier und Ehrgeiz wichen dem Verstand.&#xA;&#xA;Die Gek gerieten ins Straucheln. Unter den Erstgebrüteten herrschten Zwietracht und Spaltung." />
