			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="We have come so far and yet we are lost. The seeking of the kindred never ends. The endless night unfolds before you. &#xA;Wonder and fear. Silence and delight. Such knowledge awaits." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
