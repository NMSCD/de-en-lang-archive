		<Property name="Table" value="TkLocalisationEntry" _id="EXP_1_PLAQUE_LORE_27">
			<Property name="Id" value="EXP_1_PLAQUE_LORE_27" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Die Gek standen im Schatten der Atlas-Schnittstelle. Sie öffnete sich nicht. Sie sprach nicht zu ihnen. Und doch fühlten die Erstgebrüteten Ehrfurcht. Sie spürten ihre Bedeutungslosigkeit im Zentrum eines unendlichen Universums.&#xA;&#xA;Es war unwahrscheinlich. Und doch bleiben in der Unendlichkeit alle Dinge möglich. Die Gek änderten sich. Die Herabsetzung hatte begonnen." />
			<Property name="Spanish" value="" />
