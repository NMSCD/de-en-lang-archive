		<Property name="Table" value="TkLocalisationEntry" _id="ALL_ABAN_DESC_17">
			<Property name="Id" value="ALL_ABAN_DESC_17" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Es ist da und es ist nicht da. Wir wollen die Galaxie beherrschen, aber wir verstehen die Wahrheit nicht. Was, wenn ich dir sage, dass Zeit eine Droge ist, die uns fügsam macht und dafür sorgt, dass wir keine Fragen stellen?&#xA;&#xA;Es gibt kein Jetzt und Damals, kein Heute und Gestern. Das ist nur eine Illusion, die sich in Glas spiegelt. Eine Lüge, die uns das Universum erzählt, um über uns zu lachen.&#xA;&#xA;Wir sollen solche Dinge nicht sehen. Unsere Gedanken wehren sich, wenn die Konzepte so unvorstellbar groß werden, dass ein einziger Gedanke sie nicht mehr erfassen kann. So kontrolliert es uns." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
