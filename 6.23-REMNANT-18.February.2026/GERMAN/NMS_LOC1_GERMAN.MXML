			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="There is a horizon beyond this one, and one beyond the next. You will cross them all for us. Question nothing, fear nothing. &#xA;The calling cannot be denied. This is what you are." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
