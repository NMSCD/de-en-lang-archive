		<Property name="Table" value="TkLocalisationEntry" _id="ALL_1_RADIO_DESC_7">
			<Property name="Id" value="ALL_1_RADIO_DESC_7" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Das Kontrollterminal flackert auf und ein gedämpfter Notruf wird vom System abgesondert.&#xA;&#xA;Wenn ich seine Frequenz bestimmen kann, indem ich die Verschlüsselung knacke, könnte ich vielleicht das Schicksal des armen Piloten enthüllen. Das scheppernde Geräusch der kreischenden Motoren und die panischen Alien-Laute, die ich vernehme, sprechen aber eher für ein böses Ende." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
