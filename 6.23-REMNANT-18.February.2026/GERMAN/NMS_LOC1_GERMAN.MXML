		<Property name="Table" value="TkLocalisationEntry" _id="EXP_1_PLAQUE_LORE_23">
			<Property name="Id" value="EXP_1_PLAQUE_LORE_23" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Die Korvax-Echos im Inneren der unsichtbaren Kovergenz, die unsere Seelen miteinander verband, gaben ihre Liebe zum Atlas niemals auf. Im Lauf der Jahrtausende breitete sich diese Zuneigung aus. Der Kult des Atlas.&#xA;&#xA;Die Gleichungen und Wahrscheinlichkeiten, die den Korvax teuer waren, drangen ins Bewusstsein der Gek. Sie mussten sie nur lösen, um den Wahnsinn ihrer fehlerhaften Berechnungen in der Vergangenheit zu erkennen." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
