		<Property name="Table" value="TkLocalisationEntry" _id="ALL_ABAN_DESC_16">
			<Property name="Id" value="ALL_ABAN_DESC_16" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Wenn du klar genug siehst, wirst du auf einen Kristall stoßen, der nicht aus Atomen und Molekülen, sondern aus Gedanken, Anziehungskraft und Zahlen besteht.&#xA;&#xA;Du musst tief vordringen. Komm, schau es dir an, ich flehe dich an. Davon müssen noch andere erfahren. Sie müssen es weitersagen und die anderen Spezies warnen.&#xA; &#xA;Sag es allen. Schreib es in jeder Sprache, die du kennst, meißle es in Stein, schreie es in Liedern, aber sei nie still.&#xA;&#xA;Ich sage es dir: Ich habe gesehen, was unter der Oberfläche ruht. Das vergängliche Netz der Realität bröckelt." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
