		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="ALL_ATLAS_END_1">
			<Property name="Id" value="ALL_ATLAS_END_1" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Der Kreislauf ist vollendet. Die Unendlichkeit wartet.&#xA;&#xA;Eines Tages, tief im fernen Jenseits, findet der Atlas vielleicht endlich Frieden.&#xA;&#xA;Wir danken dir, Reisender." />
