			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Am Kontrollterminal ist ein schwaches, aber beharrliches Piepen zu vernehmen.&#xA;&#xA;Ein verstümmelter Notruf ist in alldem zu hören, zusammen mit Schreien und zerberstendem Metall. Das einzig deutlich Erscheinende ist eine kurze Zahlenfolge. Das Knacken des Codes könnte mich zur Absturzstelle führen." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
