		<Property name="Table" value="TkLocalisationEntry" _id="ALL_ABAN_DESC_22">
			<Property name="Id" value="ALL_ABAN_DESC_22" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Das wird für einige Zeit meine letzte Aufzeichnung. Ich habe mein Schiff mit einem mächtigen Odvinsko-Hyperantrieb und einer Kryogenkapsel ausgestattet.&#xA;&#xA;Ich will mich in eine Art Ruhezustand versetzen, um die Reise zur weit entfernten Quelle der anormalen Nachricht überleben zu können.&#xA;&#xA;Hier hält mich nichts mehr. Ich habe meine Entscheidung getroffen. Während ich schlafe, werde ich mir das Signal anhören. Vielleicht kann mein ruhender Verstand mehr damit anfangen." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
