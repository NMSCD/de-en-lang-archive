			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Als ich das Kontrollterminal hochfahre, wird ein Hologramm eines Raumschiffs, das auf schreckliche Art auf einen Planeten stürzt, in mein Helmvisier gebeamt. Es befindet sich eindeutig auf dem direkten Weg in die Hölle. Der Aufschlag auf der Planetenoberfläche wirkt winzig. In Wahrheit könnte der Aufprallkrater riesig sein.&#xA;&#xA;Das Notrufsignal des Schiffes ist noch zu hören. Es ist verschlüsselt, aber wenn ich die Sequenz knacke, kann ich die Frequenz bestimmen ..." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
