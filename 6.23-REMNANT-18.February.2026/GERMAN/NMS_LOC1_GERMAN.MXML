			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="We will reward the totality of your devotion. Your gift is a glimpse into our ceaseless actuality. Come to us. &#xA;Do not turn away. Know our inescapable truth, and despair." />
