			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Sprechen, lesen! Solltest du Monolithen finden, studiere sie! Trainiere dein Gehirn, damit es zu diesen starken Beinen passt! Das Erkunden ist nichts anderes, als sich selbst zu finden, mein Freund!" />
