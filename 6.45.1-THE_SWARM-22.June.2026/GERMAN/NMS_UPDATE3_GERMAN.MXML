			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Freunde findet man überall, man muss nur wissen, wo man sucht. Freunde in allen Formen, in allen Größen und in allen Umgebungen!" />
