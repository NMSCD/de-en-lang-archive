		<Property name="Table" value="TkLocalisationEntry" _id="ALL_ABAN_DESC_29">
			<Property name="Id" value="ALL_ABAN_DESC_29" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Eine Welt mit grünen Himmeln und einem Mond aus Obsidian. Das ist meine Welt. Das muss sie einfach sein. Alle behaupteten, sie würde nicht existieren, trotzdem bin ich hier und lese über ihre vermeintliche Zerstörung. Lese über ein unmögliches Paradoxon von Zeit und Verheerung.&#xA; &#xA;Ich muss zurück. Das ist das einzige Ziel, das mir noch bleibt. Bestimmt kannst du das verstehen.&#xA; &#xA;In diesem Moment hat mir meine Stimme geholfen. In diesem Moment habe ich von den Portalen erfahren." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
