			<Property name="Id" value="EXP_NPC_U3ANOMALY_LANG_3" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Nada und Polo treiben zwischen den Welten. Es gibt viele.&#xA;&#xA;Hast du sie gesehen, Reisender-Freund? Nada würde sie gerne sehen, kann aber nicht. Nada bereut vieles." />
