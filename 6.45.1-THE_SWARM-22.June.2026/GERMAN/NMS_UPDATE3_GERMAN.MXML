			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Träumer Freund oder Feind? Träumer Freund oder Feind?&#xA;&#xA;Ist Nada ein Fehler? Nada vertrauen? Dir vertrauen? Eheu! Ich werde es niemals wissen ..." />
