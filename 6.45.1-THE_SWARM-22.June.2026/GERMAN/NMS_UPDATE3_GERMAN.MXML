			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Ich stand vor dem Podium, das Wurmloch offen vor mir. Ich sollte mich privilegiert fühlen, hier zu stehen, wo so viele andere versagt haben, aber wieder habe ich diese Schuldgefühle. Es fühlt sich an, als hätte ich etwas falsch gemacht, aber so darf ich nicht denken. Ich muss nach Hause zurückkehren.&#xA; &#xA;Ich betrete es. Meine Stimme sagte, es sei in Ordnung." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
