		<Property name="Table" value="TkLocalisationEntry" _id="ALL_1_RADIO_DESC_27">
			<Property name="Id" value="ALL_1_RADIO_DESC_27" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Von diesem Ort wurde vor langer Zeit ein Notsignal abgesetzt, in dem alle Schiffe in der Nähe um Nothilfe gebeten wurden.&#xA;&#xA;Der Pilot hat anscheinend jedem Geld geboten, der auf sein Signal reagiert, und behauptet, großen Reichtum und viel Macht zu besitzen. Mit der Zeit wurde sein Angebot immer verzweifelter, bis er schließlich jedem, der ihn von diesem einsamen Ort rettet, seine ewigen Dienste anbot. Niemand hat je geantwortet.&#xA;&#xA;Ein Eingabefenster blinkt auf – ein Code muss geknackt werden ..." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
