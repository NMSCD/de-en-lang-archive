		<Property name="Table" value="TkLocalisationEntry" _id="NPC_MISSION_CRE_SCAN_8">
			<Property name="Id" value="NPC_MISSION_CRE_SCAN_8" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Der Kunde ist vom Bevölkerungsprozess der Planeten fasziniert. Es entwickeln sich immer wieder gewisse Merkmale in den verschiedenen Bereichen der Galaxie. Er würde gerne verstehen, ob diese parallelen Entwicklungen natürlich und erwartet, seltsame Zufälle, das Ergebnis eines zugrunde liegenden Musters oder durch äußere Einwirkungen entstanden sind. Der Kunde baut eine Datenbank auf, in der er die Merkmale und die Umgebungen, in denen sie entstanden sind, evaluieren kann, und sucht dafür geschäftstüchtige Entdecker." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
