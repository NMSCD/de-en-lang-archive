		<Property name="Table" value="TkLocalisationEntry" _id="EXP_NPC_U3ANOMALY_LANG_2">
			<Property name="Id" value="EXP_NPC_U3ANOMALY_LANG_2" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Nada erwachte im Schatten von Korvax Primus. Er konnte nicht verstehen, warum böse Dinge passieren. Warum wir alleine sind.&#xA;&#xA;Nada ist nicht mehr allein. Nada hat jetzt Polo-Freund. Unsere Konvergenz ist klein, aber Nada ist glücklich." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
