			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="In dieses seltsame Material ist eine Erinnerung &lt;STELLAR&gt;gebrannt&lt;&gt;, ein Echo eines anderen Lebens ...&#xA;&#xA;„Heute hätte der Tag sein sollen. Ihre Stunde hatte geschlagen.&#xA;Es muss mir gehören. So etwas habe ich noch nie gesehen.&#xA;Alles war vorbereitet. Aber es bewegte sich schneller, als ich für möglich gehalten hatte. Als wüsste es genau, wohin ich fliegen würde, noch bevor ich es wusste.&#xA;Ein Riesententakel umfing mein Schiff, mein Cockpit – presste meinen Anzug bis auf die Knochen. Dieser Anzug wird mein Grab sein.“" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
