			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Ich tat, was das Ei verlangte. Ich füllte die Seelenkammer mit den Seelen der Reisenden.&#xA;&#xA;&lt;STORY_HIGH&gt;Bist du da? Bist du – &lt;&gt;&lt;STELLAR&gt;kzkzzt&lt;&gt;&lt;STORY_HIGH&gt; – Was ist lo –&lt;&gt;&lt;STELLAR&gt;kzkzzt&lt;&gt;&lt;STORY_HIGH&gt; –&#xA;&#xA;Wo hast du – &lt;&gt;&lt;STELLAR&gt;kzkzzt&lt;&gt;&lt;STORY_HIGH&gt; – Was – &lt;&gt;&lt;STELLAR&gt;kzkzzt&lt;&gt;&lt;STORY_HIGH&gt; –&#xA;&#xA;Nein, nein, n –&lt;&gt;&lt;STELLAR&gt;kzkzzt&lt;&gt;&lt;STORY_HIGH&gt; –&lt;&gt;" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
