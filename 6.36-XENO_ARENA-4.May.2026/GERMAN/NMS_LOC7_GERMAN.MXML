			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Die „Maschine“ akzeptierte die biogene Maschine, die ich für sie gebaut hatte.&#xA;&#xA;Sie produzierte – gebar – einen Zellhaufen, etwas Proto-Gewebe. Welchen Zweck hatten diese uralten Korvax im Sinn?" />
			<Property name="Spanish" value="" />
