			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Das &lt;SPECIAL&gt;Leere-Ei&lt;&gt; bebte, als die beschwingte Musik des fremden Schiffes erneut mein Cockpit erfüllte. Es war eine Bewegung des Erkennens ...&#xA;&#xA;&lt;STORY_HIGH&gt;-{{ Die Metallmeister binden uns nicht mehr. Wir sind frei. Wir können schwimmen, fliegen, leben ... sterben ... }}-&lt;&gt;" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
