		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_CORE_11">
			<Property name="Id" value="UI_PORTAL_CORE_11" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Ich erhielt eine weitere Mitteilung von einer unbekannten Quelle, die Worte waren ein Echo dessen, was ich zuvor gehört hatte. Eine Stimme sprach zu mir, obwohl es fast so schien, als ob sie zu jemand anderem sprechen würde.&#xA;&#xA;&lt;STORY_HIGH&gt;Du bist nicht&lt;&gt; &lt;STELLAR&gt;– kzzktt –&lt;&gt;&lt;STORY_HIGH&gt; allein –&#xA;Bitte, identifiziere dich. Ich bin&lt;&gt;&lt;STELLAR&gt;– kzzkttk –&lt;&gt;&#xA;&#xA;Diesmal empfing ich eine Reihe von Koordinaten." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
