		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_TRA_LIBRARY4">
			<Property name="Id" value="UI_PORTAL_TRA_LIBRARY4" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Der Eintrag scheint eine Art interaktiver Text aus der Zweiten Handelsära zu sein. Das Terminal erlaubt es Benutzern, eine Auswahl zu treffen ...&#xA;&#xA;&lt;STORY_HIGH&gt;Die KAULQUAPPENsind aus dem LAICHGRUND entflohen. Willst du:&lt;&gt;&#xA;&#xA;&lt;VAL_ON&gt;[Nach links gehen]&lt;&gt;&#xA;&lt;STORY_HIGH&gt;Du gehst nach links. Der Xankrath verschlingt dich. Das Spiel ist vorbei.&lt;&gt;&#xA;&#xA;&lt;VAL_ON&gt;[Nach rechts gehen]&lt;&gt;&#xA;&lt;STORY_HIGH&gt;Du gehst nach rechts. Die Kaulquappen sind gerettet und werden deine Haustiere. Weiter?&lt;&gt;&#xA;&#xA;&lt;VAL_ON&gt;[Die Raumzeit transzendieren?]&lt;&gt;&#xA;&lt;STORY_HIGH&gt;Du transzendierst ...&lt;&gt;&lt;VAL_ON&gt;kzzkkt&lt;&gt;&lt;STORY_HIGH&gt; ... Raum ... &lt;&gt;&lt;VAL_ON&gt;kzzkt&lt;&gt;&lt;STORY_HIGH&gt; ... Zeit.&#xA;&#xA;Es gibt kein Gewinnen oder Verlieren, nur unendliche Traurigkeit. Ist das Spiel vorbei?&lt;&gt;" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
