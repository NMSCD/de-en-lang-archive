			<Property name="Korean" value="" />
			<Property name="Japanese" value="" />
			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_CORE_22">
			<Property name="Id" value="UI_PORTAL_CORE_22" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Apollo wollte die Sentinels studieren und hoffte, die Aufmerksamkeit der Drohnen durch einen Angriff auf eine Korvax-Fabrik auf sich zu ziehen.&#xA;&#xA;&lt;STORY_HIGH&gt;In die Fabrik eindringen und das Terminal dort hacken. Und wenn wir Daten über die Wächter bekommen? Gut. Wenn nicht, haben wir genug von ihnen heraufbeschworen, um jede Energiespitze auf eurer Welt aufzuspüren. Die Portale werden in kürzester Zeit unser sein.&lt;&gt;&#xA;&#xA;Ich schien der Köder in dieser „Falle“ zu sein." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
