		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_CORE_35">
			<Property name="Id" value="UI_PORTAL_CORE_35" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Bisher hatte ich nur die Projektionen anderer Reisender gesehen, aber noch keinen persönlich getroffen. In Artemis‘ Fall war das wahrscheinlich die einzige Möglichkeit, mit ihm zu sprechen. Bei Apollo würde das anders sein. Ich hatte die Portaladresse dieser Welt, und er müsste diesen Planeten genauso erreichen können wie ich." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
