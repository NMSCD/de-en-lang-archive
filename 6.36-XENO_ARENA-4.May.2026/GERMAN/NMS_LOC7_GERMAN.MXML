		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_BIOSHIP_11">
			<Property name="Id" value="UI_PORTAL_BIOSHIP_11" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Das Ei pulsierte mit wachsender Lebenskraft und strebte danach, sich aus seiner lederartigen Hülle zu befreien. Das Wirtsgefäß war fast vollständig. Es war als Maschine konstruiert worden, aber jetzt brauchte es einen Verstand. Ich folgte seinem Ruf zu einem seit langem verlassenen Terminal, das mit Schmutz und Verfall bedeckt war.&#xA;&#xA;&lt;STORY_HIGH&gt;Bist du das, – &lt;&gt;&lt;STELLAR&gt;kzkzzt&lt;&gt;&lt;STORY_HIGH&gt; – scheint anders zu sein.&lt;&gt;&#xA;&#xA;Das Terminal sendete ein uraltes Signal, die letzten zerbrochenen Fragmente eines gefallenen Reisenden." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
