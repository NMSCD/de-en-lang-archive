		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_CORE_42">
			<Property name="Id" value="UI_PORTAL_CORE_42" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Die &lt;TRANS_WAR&gt;Vy‘Keen&lt;&gt; erzählten mir von den Verbrechen der Gek und von seinem langen Kreuzzug gegen die Wächter. Sie verehrten den Atlas nicht wie die anderen Völker, misstrauten allem, was eine solche Macht besaß, und meinten, wenn der Atlas ein Gott sei, dann sei er wahnsinnig." />
