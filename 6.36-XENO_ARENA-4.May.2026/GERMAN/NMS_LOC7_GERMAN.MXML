		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_CORE_24">
			<Property name="Id" value="UI_PORTAL_CORE_24" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Apollo drängte mich, die Wächter aufzuspüren, um herauszufinden, ob ihre Signale tatsächlich zu einem Portal führten.&#xA;&#xA;&lt;STORY_HIGH&gt;Ich zeichnete unzählige Signale auf, als die Sentinels auftauchten. Energieströme zündeten unter der Oberfläche des Planeten und bewegten sich von Monolith zu Monolith.&#xA;&#xA;Viel Glück. Ich spreche dich auf der anderen Seite.&lt;&gt;" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
