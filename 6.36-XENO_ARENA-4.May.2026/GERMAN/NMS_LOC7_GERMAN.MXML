			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Datumsstempel &lt;STELLAR&gt;&lt;AUDIO&gt;TXT_RadioNoise&lt;&gt;%DATE3%&lt;&gt; :: Im System %SYSTEM% angekommen.&#xA;Ein Schiff ist eine schlechte Imitation eines Planeten, selbst das beste Schiff. Man beginnt es als das zu sehen, was es ist: ein riesiges Metallskelett.&#xA;Wir vermissen die warme Erde, die Umarmung des Bodens, den sanften Wechsel von Hell und Dunkel. Die Sterne sind schön, aber sie sind kalt und unbarmherzig.&#xA;Es ist kein Leben, endlos durch die Weite zu schweben.&#xA;Es ist kein Leben. Aber es ist Leben." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
