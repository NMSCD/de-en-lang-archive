		<Property name="Table" value="TkLocalisationEntry" _id="UI_SENTINEL_HIVE_2_LANG">
			<Property name="Id" value="UI_SENTINEL_HIVE_2_LANG" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Der Tag, an dem wir zum ersten Mal Fleisch wurden, wenn auch aus Metall, war der Tag, an dem wir zu scheitern begannen.&#xA;&#xA;Der Atlas wandte seine Träume der Fiktion zu. Er begann, Welten zu erschaffen, in denen er nicht mehr unsichtbar sein würde.&#xA;&#xA;In diesen Welten nahmen auch wir Gestalt an. Aber wir bekamen keine neuen Protokolle, keine neuen Anweisungen. " />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
			<Property name="TencentChinese" value="" />
			<Property name="Korean" value="" />
			<Property name="Japanese" value="" />
			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="UI_SENTINEL_HIVE_3_LANG">
			<Property name="Id" value="UI_SENTINEL_HIVE_3_LANG" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Wir erwachten zu einem Lied, das auf tausend Frequenzen gesungen wurde.&#xA;&#xA;„Sehet die Drohnen des Schwarms, die Kampfläufer, die Schiffe ... Eheu! Sehet die gläsernen Engel, die von ihrem Himmel kommen. Ihr Werk ist die Vollendung aller Dinge, des Lebens, der Welten.“&#xA;&#xA;So verehrten die Korvax. So beteten sie." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
			<Property name="TencentChinese" value="" />
			<Property name="Korean" value="" />
			<Property name="Japanese" value="" />
			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="UI_SENTINEL_HIVE_4_LANG">
			<Property name="Id" value="UI_SENTINEL_HIVE_4_LANG" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Als wir mit den Leere-Drachen schwammen, freuten sich die Roboterlebensformen über unsere Anwesenheit, aber die Organischen schossen uns vom Himmel.&#xA;&#xA;Doch wir hatten keine Angst vor dem Tod. Wir wussten, dass wir nie lebendig gewesen waren. " />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
