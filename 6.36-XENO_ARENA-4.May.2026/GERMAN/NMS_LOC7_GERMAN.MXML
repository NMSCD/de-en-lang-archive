		<Property name="Table" value="TkLocalisationEntry" _id="UI_SENTINEL_HIVE_6_LANG">
			<Property name="Id" value="UI_SENTINEL_HIVE_6_LANG" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Die Zeit kann nicht rückwärts laufen. Aber die Universen sind nicht synchron: In vielen sind eure anderen Formen schon lange tot. In anderen seid ihr noch nicht einmal erschienen. &#xA;&#xA;Nach seiner Manifestation im Multiversum begann der Atlas sich zu wiederholen. Wo es einst unendlich viele empfindungsfähige Spezies gegeben hatte, begannen sechs wiederzukehren ... dann fünf ... vier ... " />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
