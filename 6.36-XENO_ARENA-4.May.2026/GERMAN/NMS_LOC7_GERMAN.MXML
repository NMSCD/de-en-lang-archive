		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_EXP_LIBRARY2">
			<Property name="Id" value="UI_PORTAL_EXP_LIBRARY2" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Das Archiv enthält Gedankensplitter, die von gefallenen Konvergenzen geborgen wurden. Dies sind die letzten verbliebenen Gedanken elektronischer Lebensformen, die zu Millionen zerstört und eingeschmolzen wurden.&#xA;&#xA;&lt;VAL_ON&gt;[Reise]&lt;&gt;&#xA;&lt;STORY_HIGH&gt;Gehirn – &lt;&gt;&lt;VAL_ON&gt;kzzkt&lt;&gt;&lt;STORY_HIGH&gt; – in der Leere entstanden, spontan, vollständig – &lt;&gt;&lt;VAL_ON&gt;kzzkt&lt;&gt;&lt;STORY_HIGH&gt; – fleischgewordenes Atlasprotokoll.&#xA;&#xA;Atlantid, von weniger bedeutenden Stimmen Leerenmutter genannt, brachte Pilger – &lt;&gt;&lt;VAL_ON&gt;kzzkt&lt;&gt;&lt;STORY_HIGH&gt; – ihre Masse –&#xA;&#xA;lebte Jahrtausende lang – &lt;&gt;&lt;VAL_ON&gt;kzzkt&lt;&gt;&lt;STORY_HIGH&gt; – starb, flüsterte von der neunzehnten Minute.&lt;&gt;&#xA;&#xA;&lt;VAL_ON&gt;[Wiedergeburt]&lt;&gt;&#xA;&lt;STORY_HIGH&gt;Hinterlassene Geheimnisse jenseits der Berechnung, jenseits – &lt;&gt;&lt;VAL_ON&gt;kzzkt&lt;&gt;&lt;STORY_HIGH&gt; – Gedankenbögen ... Hüllen ... Konvergenz –&#xA;&#xA;Korvax ehrten Gefallene – wollten Atlantid zurückbringen, gebaren missglückte Eier ...&#xA;&#xA;Auf den Schultern eines schlafenden Gottes, aus Fleisch eine Metallwelt errichtet.&lt;&gt;&#xA;&#xA;&lt;VAL_ON&gt;[Heimat]&lt;&gt;&#xA;&lt;STORY_HIGH&gt;Die Leerenmutter lebte – &lt;&gt;&lt;VAL_ON&gt;kzzkt&lt;&gt;&lt;STORY_HIGH&gt; – Primus –&lt;&gt;" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
