		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_OVERSEER_4_C">
			<Property name="Id" value="UI_PORTAL_OVERSEER_4_C" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="&lt;STORY_HIGH&gt;-{{ Du bist zurück! Ich bin so froh, Freund! }}-&lt;&gt;&#xA;&#xA;Es ist schön zu sehen, dass der Gek so motiviert war, unser Zuhause zu verbessern. Er war offensichtlich froh, dass ich mit dem nötigen Elan an die bevorstehende Aufgabe heranging.&#xA;&#xA;&lt;STORY_HIGH&gt;-{{ Hier ist der versprochene Bauplan. Eine wirklich triviale Aufgabe. Der Code hat quasi nur darauf gewartet, manipuliert zu werden! }}-&lt;&gt;" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
