		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_CORE_14">
			<Property name="Id" value="UI_PORTAL_CORE_14" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Der Begleiter des Korvax’, Spezialist Polo, war ein ebenso ungewöhnlicher Gek, der mich freundlich begrüßte.&#xA;&#xA;&lt;STORY_HIGH&gt;-{{Freunde findet man überall, man muss nur wissen, wo man sucht. Freunde in allen Formen, in allen Größen und an allen Orten!&#xA;&#xA;Artemis-Freund ... du bist, wo sie sein sollten. Das erscheint unmöglich. Aber alles ist möglich. So ist das Universum nun mal.&#xA;&#xA;Wir werden sie finden, daran besteht kein Zweifel. Es gibt immer ein Signal oder eine Spur ... }}-&lt;&gt;" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
