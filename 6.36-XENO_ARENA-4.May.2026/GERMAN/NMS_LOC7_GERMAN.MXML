		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_CORE_21">
			<Property name="Id" value="UI_PORTAL_CORE_21" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Apollo wollte, dass ich auf alles vorbereitet bin. Während ich versuchte, meine Basis und meine Ausrüstung aufzurüsten, erreichte eine weitere anonyme Botschaft meinen Schiffskommunikator, die denselben Satz wiederholte ...&#xA;&#xA;&lt;STORY_HIGH&gt;Du bist nicht &lt;&gt;&lt;STELLAR&gt;– kzzktt –&lt;&gt;&lt;STORY_HIGH&gt; allein –&#xA;Ich kenne dich, Reisender. Ich weiß, wo du gewesen bist. Ich weiß, wohin du gehst.&#xA;... ... &lt;&gt;&lt;STELLAR&gt;– kzzzkt –&lt;&gt;&lt;STORY_HIGH&gt;... ... Es gibt keinen Grund zur Eile.&lt;&gt;&#xA;&#xA;&lt;STORY_HIGH&gt;... ... &lt;&gt;&lt;STELLAR&gt;– kzzzkt –&lt;&gt; ... ...&lt;&gt; &lt;STORY_HIGH&gt;SLASH&#xA;&lt;IMG&gt; DU WIRST UNS FINDEN, WENN DIE ZEIT REIF IST &lt;IMG&gt;SLASH&lt;&gt;&lt;&gt;" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
