		<Property name="Table" value="TkLocalisationEntry" _id="UI_ROGUE_GRAVE_STONE_DESC2">
			<Property name="Id" value="UI_ROGUE_GRAVE_STONE_DESC2" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="In dieses seltsame Material ist eine Erinnerung &lt;STELLAR&gt;gebrannt&lt;&gt;, ein Echo eines anderen Lebens ...&#xA;&#xA;„Ich werde immer wieder von demselben Albtraum geplagt: ein ohrenbetäubendes Heulen erfüllt mein Cockpit, das Armaturenbrett ist voller Blut.&#xA;Ich habe den Versuch aufgegeben, zu schlafen. Ich pulsiere an verschwommenen Sternen vorbei.&#xA;Aber da war es: gewaltig, treibend im Ozean des Alls.&#xA;Etwas in mir brennt danach. Ich muss es haben.&#xA;Seine große Flosse bog sich in Richtung meines Schiffs, und mein Rumpf war fort ...“" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
