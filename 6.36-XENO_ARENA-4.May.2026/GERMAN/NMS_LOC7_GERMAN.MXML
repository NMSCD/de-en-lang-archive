		<Property name="Table" value="TkLocalisationEntry" _id="UI_EXPED_WORMHUNT_OBJ_TIP1">
			<Property name="Id" value="UI_EXPED_WORMHUNT_OBJ_TIP1" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="‚Der Wurmfürst erhebt sich über die staubige Erde; aus seinem Fleische wird der Himmel.&#xA;Unsere erbärmlichen Hüllen können ihm nicht folgen, seine Höhen nicht erreichen, seine Tiefen nicht erreichen.&#xA;Wir opfern uns dem Erdboden.&#xA;Wir betteln um die Annahme unseres Opfers.‘&#xA;&#xA;Folge einem &lt;SPECIAL&gt;Titan-Wurm&lt;&gt;, während er über den Planeten rast.&#xA;Benutze den &lt;TECHNOLOGY&gt;Zielscan&lt;&gt;, um den heiligen Boden zu finden, an dem sie sich zum Kern des Planeten zurückziehen.&#xA;Finde den Bau dieses Titan-Wurms am Ort des Expeditionsstarts." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
			<Property name="TencentChinese" value="" />
			<Property name="Korean" value="" />
			<Property name="Japanese" value="" />
			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="UI_EXPED_WORMHUNT_OBJ_TIP2">
			<Property name="Id" value="UI_EXPED_WORMHUNT_OBJ_TIP2" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="‚Der Staub schnürte unsere Kehlen zu. &#xA;Unsere Augen waren gerötet und wässrig. &#xA;Aber die Wahrheit war unausweichlich.&#xA;Die Adern des Atlas waren aufgetaucht.‘&#xA;&#xA;Folge einem &lt;SPECIAL&gt;Titan-Wurm&lt;&gt;, während er über den Planeten rast.&#xA;Benutze den &lt;TECHNOLOGY&gt;Zielscan&lt;&gt;, um den heiligen Boden zu finden, an dem sie sich zum Kern des Planeten zurückziehen.&#xA;Finde den Bau dieses Titan-Wurms in der Nähe des &lt;STELLAR&gt;zweiten&lt;&gt; Treffpunkts." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
			<Property name="TencentChinese" value="" />
			<Property name="Korean" value="" />
			<Property name="Japanese" value="" />
			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="UI_EXPED_WORMHUNT_OBJ_TIP3">
			<Property name="Id" value="UI_EXPED_WORMHUNT_OBJ_TIP3" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="‚Nun betteln wir bei jedem Sturm darum, auserwählt zu werden;&#xA;Die Arme zum Himmel, die Gesichter zum Schmutz, herausrufend mit allem, was wir haben!&#xA;Wenn die schweren Regentropfen auf die Erde treffen, antworten die Adern des Atlas.&#xA;Die Verzückung über unsere Verzehrung ist nicht in Worte zu fassen.‘&#xA;&#xA;Folge einem &lt;SPECIAL&gt;Titan-Wurm&lt;&gt;, während er über den Planeten rast.&#xA;Benutze den &lt;TECHNOLOGY&gt;Zielscan&lt;&gt;, um den heiligen Boden zu finden, an dem sie sich zum Kern des Planeten zurückziehen.&#xA;Finde den Bau dieses Titan-Wurms in der Nähe des &lt;STELLAR&gt;dritten&lt;&gt; Treffpunkts." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
			<Property name="TencentChinese" value="" />
			<Property name="Korean" value="" />
			<Property name="Japanese" value="" />
			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="UI_EXPED_WORMHUNT_OBJ_TIP4">
			<Property name="Id" value="UI_EXPED_WORMHUNT_OBJ_TIP4" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="‚Wir stürzen, während er uns verschlingt, aber ergreifen die glitschigen Wände so gut wir nur können – &#xA;Oh! –, um den Muskelmagen im noch wachen Zustand zu erreichen. &#xA;Unsere Lungen gurgeln.&#xA;Der Schleim verstopft unsere Nasen und brennt in unseren Augen, &#xA;jedoch sind wir in dieser warmen Finsternis bereits blind.‘&#xA;&#xA;Folge einem &lt;SPECIAL&gt;Titan-Wurm&lt;&gt;, während er über den Planeten rast.&#xA;Benutze den &lt;TECHNOLOGY&gt;Zielscan&lt;&gt;, um den heiligen Boden zu finden, an dem sie sich zum Kern des Planeten zurückziehen.&#xA;Finde den Bau dieses Titan-Wurms in der Nähe des &lt;STELLAR&gt;vierten&lt;&gt; Treffpunkts." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
