		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_CORE_9">
			<Property name="Id" value="UI_PORTAL_CORE_9" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Das Signal führte mich zum Wrack eines Frachters, dessen kolossale Metallfragmente über die Landschaft verstreut waren. Waren diese Botschaften nichts anderes als die Fehlzündungen einer längst vergessenen Ruine?&#xA;&#xA;Inmitten der Trümmer fand ich das Logbuch des Piloten, das blinkend auf Eingaben wartete.&#xA;&#xA;Anstatt das Logbuch des Schiffes anzuzeigen, spuckte das Terminal eine seltsame Zahlenfolge aus. Ihnen folgte eine kurze Nachricht:&#xA;&#xA;&lt;STORY_HIGH&gt;Die Anomalie greift nach den Sternen. Fliege.&lt;&gt;" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
