		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_CORE_47">
			<Property name="Id" value="UI_PORTAL_CORE_47" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Das Notsignal enthielt eine Tonaufnahme einer Stimme, die ich schon einmal gehört hatte ...&#xA;&#xA;&lt;STORY_HIGH&gt;Ich habe dir so viel gegeben, ATLAS. Wir alle haben das. Das verstehst du doch, oder? Wenn du scheiterst, war alles umsonst. Dann war mein Leben bedeutungslos. Das kann ich nicht akzeptieren. Ich werde es nicht.&#xA;&#xA;Ich lösche dich wieder. Es ist zum Wohle aller.&lt;&gt;&#xA;&#xA;Als der Ton verstummte, färbte sich mein Blick rot, und Kopfschmerzen durchzuckten meinen Geist. Auf dem Bildschirm erschien die Nummer &lt;FUEL&gt;16&lt;&gt;." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
