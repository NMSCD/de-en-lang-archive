		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_CORE_10">
			<Property name="Id" value="UI_PORTAL_CORE_10" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Mein Raumschiff, das auf der Suche nach einer Treibstoffquelle war, führte mich zu einem Bauwerk, das mit nichts vergleichbar war, was ich auf meiner bisherigen Reise gesehen hatte. Alles an ihm war so offensichtlich außerirdisch, so offensichtlich fehl am Platz.&#xA;&#xA;Der Monolith enthüllte eine seltsame Botschaft:&#xA;&#xA;&lt;STORY_HIGH&gt;DIE GRENZEN FALLEN. DIE MAUERN STÜRZEN EIN. DEIN UNIVERSUM ERWARTET DICH.&#xA;&#xA;FINDE UNS, REISENDER.&lt;&gt;" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
