			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_CORE_17">
			<Property name="Id" value="UI_PORTAL_CORE_17" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Aufgeregt über die Aussicht auf ein Treffen, sammelte Artemis Aufzeichnungen über die von seiner Welt aus sichtbaren Sterne. Er wollte eine Route zwischen unseren Standorten bestimmen.&#xA;&#xA;&lt;STORY_HIGH&gt;Ich habe keine Ausrüstung. Ich weiß nicht, wo ich bin. Ich weiß nicht einmal, wie lange ich schon hier bin. Also habe ich einen altmodischen Ansatz gewählt. Ich habe die Sterne skizziert!&#xA;&#xA;Du solltest viele Einheimische finden, die unseren Sternenmustern entsprechen. Mein Schiff war in der Nähe, also können wir nicht weit voneinander entfernt sein ...&lt;&gt;" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
