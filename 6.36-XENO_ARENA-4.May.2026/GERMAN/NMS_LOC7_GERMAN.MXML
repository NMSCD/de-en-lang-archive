		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_FARMER_1">
			<Property name="Id" value="UI_PORTAL_FARMER_1" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Der Gek begann glücklich zu zirpen, als er mich sah.&#xA;&#xA;&lt;STORY_HIGH&gt;-{{ Freund! Du hast Arbeit für mich, ja? Ich habe in den besten Küchen und Gärten in zwölf Systemen gedient und in jedem davon preisgekröntes Essen gekocht. Ich produziere alle meine Zutaten selbst! Stellst du mich ein, ja? }}-&lt;&gt;&#xA;&#xA;Er versprach, mir dabei zu helfen, die unterschiedlichsten Nutzpflanzen auf meiner Welt anzubauen. Anscheinend wurde der nötige Papierkram bereits erledigt.&#xA;&#xA;&lt;STORY_HIGH&gt;-{{ Ich danke dir, mein Freund! Das werden weder du noch dein Magen bereuen. }}-&lt;&gt;" />
			<Property name="Spanish" value="" />
