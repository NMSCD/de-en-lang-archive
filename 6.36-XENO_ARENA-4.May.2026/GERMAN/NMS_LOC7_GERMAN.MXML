		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_EXP_LIBRARY5">
			<Property name="Id" value="UI_PORTAL_EXP_LIBRARY5" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Es gibt alte Gebete der Korvax, die aus schwachen Erinnerungen an eine längst ausgelöschte Konvergenz hervorgegangen sind. &#xA;&#xA;Die Korvax von damals schienen Wächter zu verehren und rezitierten kurze Gedichte des Lobes und der Beobachtung an ihre stillen Götter. &#xA;&#xA;&lt;STORY_HIGH&gt;Reise durch die Masse &lt;IMG&gt;SLASH&lt;&gt; Aerons gleiten mit unverdorbener Zeit dahin &lt;IMG&gt;SLASH&lt;&gt; Die Kommunion erwartet&#xA;&#xA;Zugeständnis der Läufer &lt;IMG&gt;SLASH&lt;&gt; Aeron schlummert auf grüner Wiese &lt;IMG&gt;SLASH&lt;&gt; Nachdenklicher Tag&#xA;&#xA;Das Handwerk vermerkt geleistete Arbeit &lt;IMG&gt;SLASH&lt;&gt; Piraten, Diebe des Monolithen &lt;IMG&gt;SLASH&lt;&gt; Die Korvax werden den Strom hüten&lt;&gt;" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
