		<Property name="Table" value="TkLocalisationEntry" _id="UI_SENTINEL_HIVE_18_LANG">
			<Property name="Id" value="UI_SENTINEL_HIVE_18_LANG" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Der Abgrund erzählte mir von einer Chance auf Erlösung, selbst in den Tiefen des Grauens und der Liebe. Er erzählte mir von einem Weg, wie wir das Ende aller Dinge überleben könnten.&#xA;&#xA;Er sagte mir, dass ich mit dir reden müsse. Mit euch beiden: dem Reisenden und seiner inneren Stimme ..." />
