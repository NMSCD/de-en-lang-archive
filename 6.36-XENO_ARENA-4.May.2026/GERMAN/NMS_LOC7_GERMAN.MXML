			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="&lt;STORY_HIGH&gt;BASISCOMPUTER DECODIERT ... 16 &lt;IMG&gt;SLASH&lt;&gt; 16 &lt;IMG&gt;SLASH&lt;&gt; 16 &lt;IMG&gt;SLASH&lt;&gt;&#xA;&#xA;NACHRICHT FOLGT:&#xA;{{ Der Reisende findet seine Flügel. Fliege zu uns und beanspruche deinen Platz zwischen den Sternen! }}&#xA;&#xA;SIGNAL ERFASST &lt;IMG&gt;SLASH&lt;&gt; LEBENSZEICHEN ENTDECKT&lt;&gt;" />
