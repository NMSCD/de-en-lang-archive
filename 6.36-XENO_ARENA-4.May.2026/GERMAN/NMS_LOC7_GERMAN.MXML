			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
			<Property name="TencentChinese" value="" />
			<Property name="Korean" value="" />
			<Property name="Japanese" value="" />
			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_CORE_18">
			<Property name="Id" value="UI_PORTAL_CORE_18" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Als ich der lokalen Bevölkerung Artemis’ Sternenkarte zeigte, behauptete sie, dass eine solche Anordnung der Sterne nicht existierte. Irgendwas schien gewaltig nicht zu stimmen." />
