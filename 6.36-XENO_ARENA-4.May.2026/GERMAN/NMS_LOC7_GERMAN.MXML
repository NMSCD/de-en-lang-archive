			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_OVERSEER_4_B">
			<Property name="Id" value="UI_PORTAL_OVERSEER_4_B" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Der Ort, an den mich mein Aufseher geführt hatte, war schon seit Langem verfallen. Die Luft war übel riechend und feucht. Ich schaltete das Terminal ohne große Hoffnung ein, aber zu meiner Überraschung summte es lautstark und erwachte zum Leben.&#xA;&#xA;Die Intuition meines Aufsehers hatte mich bis dahin nicht im Stich gelassen. Ich musste darauf vertrauen, dass diese Baupläne die benötigten Daten enthielten." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
