		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_CORE_49">
			<Property name="Id" value="UI_PORTAL_CORE_49" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Die Stimme meines Exo-Anzugs sagte mir, dass er mich gerettet hatte.&#xA;&#xA;&lt;STORY_HIGH&gt;EKEL | FURCHT | PANIKREAKTION [&lt;&gt;&lt;TRADABLE&gt;ENTDECKT&lt;&gt;&lt;STORY_HIGH&gt;]&#xA;&#xA;GEGENMASSNAHME [&lt;&gt;&lt;STELLAR&gt;BEGONNEN&lt;&gt;&lt;STORY_HIGH&gt;] &lt;IMG&gt;SLASH&lt;&gt; SÄUBERUNG [&lt;&gt;&lt;TECHNOLOGY&gt;NEUTRALISIERT&lt;&gt;&lt;STORY_HIGH&gt;]&lt;&gt;&#xA;&#xA;Auf eine seltsame Art war diese Stimme mein ältester Freund, ein ständiger Begleiter durch dick und dünn.&#xA;&#xA;Ich wusste, was ich zu tun hatte. Alle Wege hatten mich dorthin geführt, jedes Portal brachte mich näher und näher. Ich musste in das Zentrum dieser Galaxie gehen. Es war das Epizentrum des Glitches.&#xA;&#xA;Ich musste unseren Schöpfer konfrontieren und herausfinden, was als Nächstes passieren würde." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
