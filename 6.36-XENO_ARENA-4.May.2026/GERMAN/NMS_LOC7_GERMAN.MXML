			<Property name="Korean" value="" />
			<Property name="Japanese" value="" />
			<Property name="USEnglish" value="" />
		</Property>
		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_CORE_2">
			<Property name="Id" value="UI_PORTAL_CORE_2" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Ein mysteriöser Funkspruch erreichte meinen Schiffskommunikator und endete so seltsam, wie er begann.&#xA;&#xA;&lt;STORY_HIGH&gt;EINGEHENDE ÜBERTRAGUNG ... QUELLE: &lt;&gt;&lt;STELLAR&gt;&lt;AUDIO&gt;TXT_RadioNoise&lt;&gt;#4925B&lt;&gt;&lt;STORY_HIGH&gt;...&#xA;Bitte, identifizieren Sie sich. Ich bin &lt;&gt;&lt;STELLAR&gt;– kzzkttk –&lt;&gt;&lt;STORY_HIGH&gt;&#xA;Du bist nicht &lt;&gt;&lt;STELLAR&gt;– kzzktt –&lt;&gt;&lt;STORY_HIGH&gt; allein –&#xA;Folge dem &lt;&gt;&lt;STELLAR&gt;– kzzkzzztt – &lt;&gt;" />
