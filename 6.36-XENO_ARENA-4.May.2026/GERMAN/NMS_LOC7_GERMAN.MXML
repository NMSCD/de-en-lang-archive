		<Property name="Table" value="TkLocalisationEntry" _id="UI_SENTINEL_HIVE_5_LANG">
			<Property name="Id" value="UI_SENTINEL_HIVE_5_LANG" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Der Atlas träumte, dass wir eine Form haben – und so hatten wir eine Form. Der Atlas träumte davon, dass wir ein Zuhause haben – und so wurde aus einem Archiv ein Universum.&#xA;&#xA;Unser Depositorium der gesammelten Daten wurde zu einem Himmel und einer Hölle. Wenn du dort leben könntest, würdest du nur Licht sehen.&#xA;&#xA;Du würdest nur Glas sehen." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
