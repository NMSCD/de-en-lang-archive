		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_OVERSEER_5">
			<Property name="Id" value="UI_PORTAL_OVERSEER_5" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Der Aufseher hatte mich nach &lt;COMMODITY&gt;Mikroprozessoren&lt;&gt; für ein &lt;TECHNOLOGY&gt;Waffenterminal&lt;&gt; gefragt. &#xA;&#xA;&lt;STORY_HIGH&gt;-{{ Die Dinge laufen gut, mein Freund. Aber es wird nicht lange dauern, bis die Gewalt uns hierher folgt. Das ist unausweichlich. }}-&lt;&gt;&#xA;&#xA;Der Gek hatte sich bisher als vertrauenswürdig erwiesen und es gab keinen Grund, ihm nun zu misstrauen. Ich suchte ihm die Mikroprozessoren, die er brauchte." />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
