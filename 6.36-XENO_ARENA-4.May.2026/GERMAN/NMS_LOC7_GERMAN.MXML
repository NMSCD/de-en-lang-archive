		<Property name="Table" value="TkLocalisationEntry" _id="UI_PORTAL_CORE_13">
			<Property name="Id" value="UI_PORTAL_CORE_13" />
			<Property name="English" value="" />
			<Property name="French" value="" />
			<Property name="Italian" value="" />
			<Property name="German" value="Ich erreichte eine seltsame Raumstation, die ein anomales Signal aussandte, als ob sie direkt und ausschließlich zu mir sprechen würde. Eine Reihe anderer sogenannter „Reisender“ wohnte an Bord, aber es war ein ungewöhnlicher Korvax, der mich begrüßte.&#xA;&#xA;&lt;STORY_HIGH&gt;-{{Ich bin Priester-Entität Nada, divergenter Korvax. Willkommen in unserer Anomalie.&#xA;&#xA;Unser Zuhause hier ist angenehm, ja? Polos eigener Entwurf. Eine perfekte Blase, jenseits der Wächter, jenseits der rachsüchtigen Korvax. Nada sieht zu, wie die Zeit kommt und geht. }}-&lt;&gt;" />
			<Property name="Spanish" value="" />
			<Property name="Russian" value="" />
			<Property name="Polish" value="" />
			<Property name="Dutch" value="" />
			<Property name="Portuguese" value="" />
			<Property name="LatinAmericanSpanish" value="" />
			<Property name="BrazilianPortuguese" value="" />
			<Property name="SimplifiedChinese" value="" />
			<Property name="TraditionalChinese" value="" />
